# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell scripts must always use LF line endings (for Docker/Linux)
*.sh text eol=lf

# Dockerfiles should use LF
Dockerfile* text eol=lf
*.Dockerfile text eol=lf

# Batch files should use CRLF (Windows)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
